# /etc/sermon-studio/sermon-studio.env: the studio's settings on this host (quadlet/sermon-studio.container).
# Root's, readable by the group sermon-studio only (install.sh sets that). Every setting: docs/running.md;
# the login with Pocket ID: docs/login-pocket-id.md. One KEY=value a line, no quotes.

# The login: Pocket ID at id.<domain> (quadlet/pocket-id.container) and the studio's OIDC client there. The
# secret is read by the studio and removed from its environment at once.
SERMON_STUDIO_OIDC_ISSUER=https://id.example.org
SERMON_STUDIO_OIDC_CLIENT_ID=
SERMON_STUDIO_OIDC_CLIENT_SECRET=
SERMON_STUDIO_OIDC_SIGNUP_URL=https://id.example.org/signup

# Every church at <church>.example.org; the login, invite links and the church picker at my.example.org.
SERMON_STUDIO_PUBLIC_URL=https://my.example.org/
SERMON_STUDIO_CHURCH_HOST={church}.example.org
SERMON_STUDIO_COOKIE_DOMAIN=example.org

# The public share page, where recordings are sent and sermons downloaded with a code.
SERMON_STUDIO_SHARE_URL=https://share.example.org/

# Runs (making the files) at once, across all churches; each uses about one core.
SERMON_STUDIO_PARALLEL_RUNS=2
