# /etc/sermon-studio/pocket-id.env: Pocket ID's settings (quadlet/pocket-id.container). Root's, readable by
# the group pocket-id only. One KEY=value a line, no quotes.
#
# Pocket ID starts once this file is there. On an empty /srv/pocket-id/data it is a new Pocket ID, whose first
# visitor sets up its admin: open https://id.<domain>/setup yourself as soon as it runs.

APP_URL=https://id.example.org

# The key its database is encrypted with (openssl rand -base64 32). Keep a copy away from this machine, in a
# password manager: a backup of the database is no use without it.
ENCRYPTION_KEY=

# Pocket ID takes the visitor's address from X-Forwarded-For (set by Cloudflare). Every peer is trusted:
# its port is published on 127.0.0.1 only, so the one peer is cloudflared, and through Podman (pasta) it
# arrives from the machine's own address, not 127.0.0.1.
TRUST_PROXY=true
