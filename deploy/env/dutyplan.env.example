# /etc/sermon-studio/dutyplan.env: Dutyplan's settings (quadlet/dutyplan.container). Root's, readable by the
# group dutyplan only. One KEY=value a line, no quotes. Dutyplan starts once this file is there.
#
# Its client in Pocket ID: confidential, PKCE, callback https://dutyplan.<domain>/auth/callback, logout
# callback https://dutyplan.<domain>/, no user groups (anyone who signs up may use it). The client secret goes
# in /etc/sermon-studio/dutyplan-client-secret (the secret alone), made the same way as this file.

DUTYPLAN_PUBLIC_URL=https://dutyplan.example.org/
DUTYPLAN_OIDC_ISSUER=https://id.example.org
DUTYPLAN_OIDC_CLIENT_ID=
DUTYPLAN_OIDC_SIGNUP_URL=https://id.example.org/signup
TZ=Europe/Oslo
